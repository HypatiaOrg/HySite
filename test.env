# Settings for compose.test.yaml: the site against the local sample database.
# Test-only credentials; the sample database never leaves the test containers.
COMPOSE_PROFILES=api,db
DATABASE_TYPE=local
MONGO_HOST=mongoDB
MONGO_DATABASE=public
CLIENT_TLS=false
MONGO_USERNAME=admin
MONGO_PASSWORD=test-only-password
INTERACTIVE_STARNAMES=false
READ_ONLY=true
SSL_KEYS_VOLUME_EXTERNAL=false
LOCAL_PORT=8081
# MongoDB 9.0 refuses Linux kernels 6.19 to 7.0.13 unless its allocator leaves rseq to glibc (see
# compose.yaml). The production server is on such a kernel, so the test stack needs this too; on other
# machines it only turns off an allocator optimisation that the tests do not care about.
MONGO_GLIBC_TUNABLES=glibc.pthread.rseq=1
