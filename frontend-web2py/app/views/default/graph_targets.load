{{=XML(div)}}

<script>
    //$("#stars").get(0).reload();
    refresh_table();
    // the bin size boxes' warnings (controllers/default.py, bin_warnings): shown next to the box, or cleared
    $(".bin-warning").hide().text("");
    {{for key, text in warnings.items():}}
    $("#{{=key}}-warning").text("{{=text}}").show();
    {{pass}}
    $("#hist").css("background","white");
</script>