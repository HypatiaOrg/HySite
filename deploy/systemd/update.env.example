# Settings for the HySite update job. Copy to /etc/hysite/update.env and keep it private:
#   sudo install -D --mode 600 --owner root --group root deploy/systemd/update.env.example /etc/hysite/update.env
# systemd reads it as root, so the job's user does not need to read the file.

# The repository and branch the server deploys
HYSITE_REPO=/home/ubuntu/HySite
HYSITE_BRANCH=main
# Where the smoke test reaches production. The public address goes through the HTTPS edge
# (HyRoute), so the edge's image and configuration are checked too; http://localhost skips it
HYSITE_URL=https://hypatiacatalog.com
# HyRoute's compose file: its nginx is recreated with the tested NGINX_IMAGE on every deploy.
# Leave the file absent on a server without the edge
HYSITE_EDGE_COMPOSE=/home/ubuntu/HyRoute/compose.yaml

# hysite_ops database: a user with readWrite on hysite_ops ONLY, separate from the website's
# read-only user. See the wiki page "Keeping HySite Up to Date" for the createUser command.
# Every name here starts with HYSITE_, OPS_ or ALERT_: Docker Compose would let names like
# MONGO_HOST or CLIENT_TLS override the website's own .env settings.
OPS_MONGO_HOST=hypatiacatalog.com
OPS_MONGO_PORT=27017
OPS_CLIENT_TLS=true
OPS_USERNAME=hysite_updater
OPS_PASSWORD=replace-with-the-real-password
OPS_AUTH_SOURCE=admin

# Failure emails (scripts/send_alert.sh). Needs a working sendmail, e.g. msmtp-mta set up for AWS SES.
ALERT_EMAIL=you@example.edu
ALERT_FROM=hysite@hypatiacatalog.com
