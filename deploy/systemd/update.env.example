# Settings for the HySite update job. Copy to /etc/hysite/update.env and keep it private:
#   sudo install -D --mode 600 --owner root --group root deploy/systemd/update.env.example /etc/hysite/update.env
# systemd reads it as root, so the job's user does not need to read the file.

# The repository and branch the server deploys
HYSITE_REPO=/home/ubuntu/HySite
HYSITE_BRANCH=main
# Where the smoke test reaches production. The public address goes through the HTTPS edge
# (HyRoute), so the edge's image and configuration are checked too; http://localhost skips it
HYSITE_URL=https://hypatiacatalog.com
# The other sites on this server whose nginx is recreated with the tested NGINX_IMAGE on every deploy:
# the HTTPS edge (HyRoute) and the CWSite page. Their compose files must name the service "nginx" and
# use ${NGINX_IMAGE:-nginx:alpine}, as the image or as the build's BASE_IMAGE. Space-separated; a file
# that is absent is skipped. The job deploys whatever their checkouts hold (code arrives by git push from
# the owner's computer, see their READMEs); a new commit there counts as a change
HYSITE_NGINX_COMPOSE="/home/ubuntu/HyRoute/compose.yaml /home/ubuntu/CWSite/compose.yaml"
# addresses of those sites that must answer after a deploy (the edge is covered by HYSITE_URL above)
HYSITE_NGINX_CHECK_URLS="https://calebwheeler.com/"

# hysite_ops database: a user with readWrite on hysite_ops ONLY, separate from the website's
# read-only user. See the wiki page "Keeping HySite Up to Date" for the createUser command.
# Every name here starts with HYSITE_, OPS_ or ALERT_: Docker Compose would let names like
# MONGO_HOST or CLIENT_TLS override the website's own .env settings.
OPS_MONGO_HOST=hypatiacatalog.com
OPS_MONGO_PORT=27017
OPS_CLIENT_TLS=true
OPS_USERNAME=hysite_updater
OPS_PASSWORD=replace-with-the-real-password
OPS_AUTH_SOURCE=admin

# Failure emails (scripts/send_alert.sh, scripts/send_mail.py). Several recipients: separate with commas.
ALERT_EMAIL=you@example.edu
# The SMTP account that sends them. For Gmail: the address of a Google account with 2-step verification,
# and an app password made at https://myaccount.google.com/apppasswords (16 letters; spaces are fine).
# Gmail sends from that address whatever ALERT_FROM says. Test with:
#   sudo systemctl start hysite-alert@test.service && journalctl --unit hysite-alert@test.service --invocation 0
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=hysite.alerts@gmail.com
ALERT_SMTP_PASSWORD=replace-with-the-app-password
ALERT_FROM=hysite.alerts@gmail.com
# ALERT_SMTP_DEBUG=true   # the conversation with the server in the alert unit's journal (login masked)
# ALERT_SMTP_IPV4=true    # connect over IPv4 only
# Without ALERT_SMTP_HOST the message goes to a sendmail program instead (msmtp-mta, for example)

# A report after every run, also when nothing changed: status, code, image and package changes, test
# results (scripts/send_report.py). Through the same account. Leave it out or empty for no report
HYSITE_REPORT_EMAIL=you@example.edu
